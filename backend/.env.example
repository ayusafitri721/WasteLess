NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/wasteless?replicaSet=rs0
JWT_ACCESS_SECRET=isi-dengan-rahasia-minimal-32-karakter
JWT_ACCESS_EXPIRES_IN=15m
CLIENT_ORIGIN=http://localhost:3000
EXPIRATION_JOB_INTERVAL_MS=60000

# OAuth Google dan GitHub (opsional; isi untuk mengaktifkan tombol login sosial)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_BACKEND_ORIGIN=http://localhost:5000
OAUTH_STATE_TTL_SECONDS=600
OAUTH_EXCHANGE_TTL_SECONDS=300

# Pengiriman email reset password (opsional; isi supaya tautan benar-benar dikirim)
# Gmail: aktifkan 2FA lalu buat App Password, bukan memakai password akun biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="WasteLess <nama@gmail.com>"
